# Copia este archivo a .env.production en la VPS y completa los valores.
# Nunca subas .env.production al repositorio.

# Postgres (Docker solo DB)
POSTGRES_USER=wandy
POSTGRES_PASSWORD=cambia-esta-clave-fuerte
POSTGRES_DB=wandy
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# API
JWT_SECRET=cambia-este-secreto-jwt-largo-y-aleatorio
JWT_EXPIRES_IN=8h
# Orígenes permitidos (coma-separados). Con subdominio HTTPS:
# CORS_ORIGIN=https://corporaciondestellos.fersuastudio.com
CORS_ORIGIN=http://TU_IP:8085
# true solo la primera vez para crear admin/profesional de prueba
RUN_SEED=true

# Puertos locales PM2 (Nginx del host hace proxy público)
HTTP_PORT=8085
API_PORT=3085

# URL pública que usa el front al hacer fetch(.../api/...)
# Con subdominio + Nginx proxy /api → API_PORT, usa el dominio HTTPS (sin /api):
#   VITE_API_URL=https://corporaciondestellos.fersuastudio.com
# Vacío = mismo origen (también válido si Nginx proxya /api).
# NO uses http://IP:3085 detrás de HTTPS (mixed content).
VITE_API_URL=https://corporaciondestellos.fersuastudio.com
