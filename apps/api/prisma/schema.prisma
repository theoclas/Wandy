generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFESSIONAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum PatientPhaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// Cómo se desbloquean los subgrupos dentro de una fase.
enum PhaseUnlockMode {
  /// Todos los subgrupos editables a la vez (Destellos, Esplendor).
  ALL_OPEN
  /// Se desbloquean por unlockRank ascendente (1 → 2 → 3…).
  SEQUENTIAL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  professional  Professional?
  scoreChanges  ScoreChangeLog[]
}

model Professional {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  document     String   @unique
  phone        String?
  email        String?
  address      String?
  gender       Gender   @default(UNSPECIFIED)
  specialty    String?
  active       Boolean  @default(true)
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patients Patient[]
}

model PatientType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patients Patient[]
}

model Patient {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  document        String   @unique
  phone           String?
  email           String?
  address         String?
  gender          Gender   @default(UNSPECIFIED)
  birthDate       DateTime @db.Date
  systemEntryDate DateTime @default(now()) @db.Date
  centerEntryDate DateTime @db.Date
  patientTypeId   String
  professionalId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patientType     PatientType      @relation(fields: [patientTypeId], references: [id])
  professional    Professional?    @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  clinicalHistory ClinicalHistory?
}

model PhaseTemplate {
  id          String          @id @default(uuid())
  sortOrder   Int             @unique
  name        String
  description String?
  unlockMode  PhaseUnlockMode @default(ALL_OPEN)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subgroups     SubgroupTemplate[]
  patientPhases PatientPhase[]
}

model SubgroupTemplate {
  id              String   @id @default(uuid())
  phaseTemplateId String
  sortOrder       Int
  /// Orden de desbloqueo interno (1 = primero). Solo aplica si la fase es SEQUENTIAL.
  unlockRank      Int      @default(1)
  name            String
  purpose         String?
  /// Si true, la UI no muestra el título del subgrupo (Esplendor).
  hideInUi        Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  phaseTemplate    PhaseTemplate          @relation(fields: [phaseTemplateId], references: [id], onDelete: Cascade)
  criteria         CriterionTemplate[]
  patientSubgroups PatientSubgroup[]

  @@unique([phaseTemplateId, sortOrder])
}

model CriterionTemplate {
  id                 String   @id @default(uuid())
  subgroupTemplateId String
  sortOrder          Int
  label              String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subgroupTemplate SubgroupTemplate         @relation(fields: [subgroupTemplateId], references: [id], onDelete: Cascade)
  scores           PatientCriterionScore[]

  @@unique([subgroupTemplateId, sortOrder])
}

model ClinicalHistory {
  id          String   @id @default(uuid())
  patientId   String   @unique
  historyDate DateTime @default(now()) @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  phases  PatientPhase[]
}

model PatientPhase {
  id                String             @id @default(uuid())
  clinicalHistoryId String
  phaseTemplateId   String
  status            PatientPhaseStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  clinicalHistory ClinicalHistory   @relation(fields: [clinicalHistoryId], references: [id], onDelete: Cascade)
  phaseTemplate   PhaseTemplate     @relation(fields: [phaseTemplateId], references: [id])
  subgroups       PatientSubgroup[]

  @@unique([clinicalHistoryId, phaseTemplateId])
}

model PatientSubgroup {
  id                 String   @id @default(uuid())
  patientPhaseId     String
  subgroupTemplateId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patientPhase     PatientPhase             @relation(fields: [patientPhaseId], references: [id], onDelete: Cascade)
  subgroupTemplate SubgroupTemplate         @relation(fields: [subgroupTemplateId], references: [id])
  criterionScores  PatientCriterionScore[]

  @@unique([patientPhaseId, subgroupTemplateId])
}

model PatientCriterionScore {
  id                  String   @id @default(uuid())
  patientSubgroupId   String
  criterionTemplateId String
  score               Float    @default(0)
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  patientSubgroup   PatientSubgroup    @relation(fields: [patientSubgroupId], references: [id], onDelete: Cascade)
  criterionTemplate CriterionTemplate  @relation(fields: [criterionTemplateId], references: [id])
  changeLogs        ScoreChangeLog[]

  @@unique([patientSubgroupId, criterionTemplateId])
}

model ScoreChangeLog {
  id                      String   @id @default(uuid())
  patientCriterionScoreId String
  previousScore           Float
  newScore                Float
  changedAt               DateTime @default(now())
  changedById             String

  patientCriterionScore PatientCriterionScore @relation(fields: [patientCriterionScoreId], references: [id], onDelete: Cascade)
  changedBy             User                  @relation(fields: [changedById], references: [id])
}
